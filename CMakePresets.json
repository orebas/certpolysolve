{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Portable release and routine correctness",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "sanitized",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/sanitized",
      "cacheVariables": {
        "CERTPOLYSOLVE_SANITIZERS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer for the thread tests (GCC; FLINT from CERTPOLYSOLVE_TSAN_FLINT_ROOT)",
      "description": "Set CERTPOLYSOLVE_TSAN_FLINT_ROOT to the prefix of a FLINT 3.6 built with -fsanitize=thread by the same compiler: against the system FLINT, ThreadSanitizer sees nothing inside FLINT (docs/thread-safety-audit-20261018.md, F1). GCC, because its TSan runtime comes with the compiler; clang's is a separate package.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON",
        "CERTPOLYSOLVE_TSAN": "ON",
        "FLINT_ROOT": "$env{CERTPOLYSOLVE_TSAN_FLINT_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 2
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized",
      "jobs": 2
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "jobs": 6
    }
  ],
  "testPresets": [
    {
      "name": "quick",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "quick"
        }
      },
      "execution": {
        "jobs": 2
      }
    },
    {
      "name": "correctness",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "correctness"
        }
      },
      "execution": {
        "jobs": 2
      }
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "api"
        }
      },
      "execution": {
        "jobs": 2
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "threads"
        }
      },
      "environment": {
        "TSAN_OPTIONS": "suppressions=${sourceDir}/tests/tsan.supp halt_on_error=1 second_deadlock_stack=1"
      },
      "execution": {
        "jobs": 2
      }
    }
  ]
}
