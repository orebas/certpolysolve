# (docs/quickstart-cpp.md): each builds and runs, and examples_quoted checks that the guides quote them as they
# are. The C programs are C99. The C++ programs are C++23 (std::println); a toolchain without it skips them.
file(GLOB CERTPOLYSOLVE_GUIDE_C_EXAMPLES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/examples/guide/*.c")
foreach(example ${CERTPOLYSOLVE_GUIDE_C_EXAMPLES})
    get_filename_component(example_name ${example} NAME_WE)
    add_executable(guide_${example_name}_c ${example})
    set_target_properties(guide_${example_name}_c PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED ON)
    target_link_libraries(guide_${example_name}_c PRIVATE CertPolySolve::certpolysolve)
    add_test(NAME guide_${example_name}_c COMMAND guide_${example_name}_c)
    set_tests_properties(guide_${example_name}_c PROPERTIES TIMEOUT 120)
endforeach()
include(CheckCXXSourceCompiles)
set(CMAKE_REQUIRED_FLAGS "${CMAKE_CXX23_STANDARD_COMPILE_OPTION}")
check_cxx_source_compiles("#include <print>\nint main() { std::println(\"{}\", 1); }" CERTPOLYSOLVE_HAVE_STD_PRINT)
unset(CMAKE_REQUIRED_FLAGS)
if(CERTPOLYSOLVE_HAVE_STD_PRINT)
    file(GLOB CERTPOLYSOLVE_QUICKSTART_EXAMPLES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/examples/quickstart/*.cpp")
    foreach(example ${CERTPOLYSOLVE_QUICKSTART_EXAMPLES})
        get_filename_component(example_name ${example} NAME_WE)
        add_executable(quickstart_${example_name} ${example})
        set_target_properties(quickstart_${example_name} PROPERTIES CXX_STANDARD 23 CXX_STANDARD_REQUIRED ON)
        target_link_libraries(quickstart_${example_name} PRIVATE CertPolySolve::certpolysolve Threads::Threads)
        add_test(NAME quickstart_${example_name} COMMAND quickstart_${example_name})
        set_tests_properties(quickstart_${example_name} PROPERTIES TIMEOUT 120)
    endforeach()
    # The examples by topic (docs/examples-cpp.md), built and run the same way.
    file(GLOB CERTPOLYSOLVE_TOPIC_EXAMPLES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/examples/topics/*.cpp")
    foreach(example ${CERTPOLYSOLVE_TOPIC_EXAMPLES})
        get_filename_component(example_name ${example} NAME_WE)
        add_executable(topic_${example_name} ${example})
        set_target_properties(topic_${example_name} PROPERTIES CXX_STANDARD 23 CXX_STANDARD_REQUIRED ON)
        target_link_libraries(topic_${example_name} PRIVATE CertPolySolve::certpolysolve Threads::Threads)
        add_test(NAME topic_${example_name} COMMAND topic_${example_name})
        set_tests_properties(topic_${example_name} PROPERTIES TIMEOUT 120)
    endforeach()
    add_executable(guide_first_solve_cpp examples/guide/first_solve.cpp)
    set_target_properties(guide_first_solve_cpp PROPERTIES CXX_STANDARD 23 CXX_STANDARD_REQUIRED ON)
    target_link_libraries(guide_first_solve_cpp PRIVATE CertPolySolve::certpolysolve Threads::Threads)
    add_test(NAME guide_first_solve_cpp COMMAND guide_first_solve_cpp)
    set_tests_properties(guide_first_solve_cpp PROPERTIES TIMEOUT 120)
    # The README's first solve (examples/readme/first_solve.cpp), quoted there verbatim (examples_quoted).
    add_executable(readme_first_solve examples/readme/first_solve.cpp)
    set_target_properties(readme_first_solve PROPERTIES CXX_STANDARD 23 CXX_STANDARD_REQUIRED ON)
    target_link_libraries(readme_first_solve PRIVATE CertPolySolve::certpolysolve Threads::Threads)
    add_test(NAME readme_first_solve COMMAND readme_first_solve)
    set_tests_properties(readme_first_solve PROPERTIES TIMEOUT 120)
else()
    message(STATUS "The C++ examples skipped: they need C++23's <print>")
endif()
find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_Interpreter_FOUND)
    add_test(NAME prepared_isolation_fixtures COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/subdivision/check_isolation_fixtures.py")
    set_tests_properties(prepared_isolation_fixtures PROPERTIES TIMEOUT 30 LABELS "correctness;quick")
    add_test(NAME secular_cli COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_secular_cli.py" $<TARGET_FILE:certpolysolve_cli>)
    set_tests_properties(secular_cli PROPERTIES TIMEOUT 120)
    # Local Markdown links resolve and docs/README.md lists every report.
    add_test(NAME doc_links COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_doc_links.py")
    set_tests_properties(doc_links PROPERTIES TIMEOUT 60)
    add_test(NAME examples_quoted COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_examples_quoted.py")
    # The pages a user reads carry no dates, hashes or words of the project's own process (docs/WRITING.md).
    add_test(NAME doc_residue COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_doc_residue.py")
    set_tests_properties(doc_residue PROPERTIES TIMEOUT 60)
    set_tests_properties(examples_quoted PROPERTIES TIMEOUT 60)
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(Python3_Interpreter_FOUND)
        add_library(forbidden_root_solvers SHARED tests/forbidden_root_solvers.c)
        target_link_libraries(forbidden_root_solvers PRIVATE FLINT::FLINT)
        add_executable(backend_trap_probe tests/backend_trap_probe.c)
        target_link_libraries(backend_trap_probe PRIVATE FLINT::FLINT)
        set(certpolysolve_research_trap)
        add_test(NAME no_backend_solvers COMMAND "${Python3_EXECUTABLE}"
            "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_no_backend_solvers.py"
            $<TARGET_FILE:certpolysolve> $<TARGET_FILE:forbidden_root_solvers>
            $<TARGET_FILE:backend_trap_probe> $<TARGET_FILE:test_mathematics>
            $<TARGET_FILE:test_structured> $<TARGET_FILE:test_real_refinement> ${certpolysolve_research_trap}
            $<TARGET_FILE:test_study> $<TARGET_FILE:test_d3> $<TARGET_FILE:test_methods>)
        # The script runs each trapped binary under a 180 s limit, which an uninstrumented-by-sanitizer -O0
        # build meets with a margin of 1.46 (test_real_refinement, the longest, 123 s in GCC's -O0 build with
        # gcov instrumentation, --coverage, on 20 October 2026; 17 s in Release). Under AddressSanitizer at -O0
        # the same binary took 227 s (Clang) and 178 s (GCC), over the limit
        # (measured with AddressSanitizer). A sanitizer build multiplies the limit by this factor,
        # the smallest integer that gives the measured 227 s at least that margin (360 / 227 = 1.59).
        set(CERTPOLYSOLVE_INSTRUMENTED_SLOWDOWN 2)
        if(CERTPOLYSOLVE_SANITIZERS OR CERTPOLYSOLVE_TSAN)
            set_property(TEST no_backend_solvers APPEND PROPERTY ENVIRONMENT
                "CERTPOLYSOLVE_TEST_TIME_FACTOR=${CERTPOLYSOLVE_INSTRUMENTED_SLOWDOWN}")
        endif()
    endif()
endif()
