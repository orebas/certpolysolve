# Private compilation units follow the same ownership manifest as the include checker.
# No module target is installed. certpolysolve_core preserves the internal aggregate used
# by white-box tests and workers; each object reaches a consumer exactly once.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/modules.json" certpolysolve_module_manifest)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/modules.json")
string(JSON certpolysolve_owned_count LENGTH "${certpolysolve_module_manifest}" owners)
math(EXPR certpolysolve_owned_last "${certpolysolve_owned_count} - 1")
foreach(index RANGE ${certpolysolve_owned_last})
    string(JSON source MEMBER "${certpolysolve_module_manifest}" owners ${index})
    if(NOT source MATCHES "\\.cpp$")
        continue()
    endif()
    if(source MATCHES "^research/" AND NOT CERTPOLYSOLVE_BUILD_RESEARCH)
        continue()
    endif()
    string(JSON module GET "${certpolysolve_module_manifest}" owners "${source}")
    # The API is compiled into the shared target with its export definition.
    if(module STREQUAL "api")
        list(APPEND certpolysolve_api_sources "${source}")
    else()
        list(APPEND certpolysolve_module_names "${module}")
        list(APPEND certpolysolve_sources_${module} "${source}")
    endif()
endforeach()
list(REMOVE_DUPLICATES certpolysolve_module_names)

foreach(module IN LISTS certpolysolve_module_names)
    set(target certpolysolve_${module}_objects)
    add_library(${target} OBJECT ${certpolysolve_sources_${module}})
    list(APPEND certpolysolve_module_targets ${target})
    target_compile_features(${target} PUBLIC cxx_std_20)
    target_include_directories(${target} PRIVATE include src)
    target_link_libraries(${target} PRIVATE FLINT::FLINT Threads::Threads)
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive-)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion)
    endif()
    certpolysolve_strict_floating_point(${target})
    if(CERTPOLYSOLVE_SANITIZERS)
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    endif()
    if(CERTPOLYSOLVE_TSAN)
        target_compile_options(${target} PRIVATE -fsanitize=thread -fno-omit-frame-pointer)
    endif()
endforeach()

# Record the declared DAG in the build too. Include-level interface restrictions
# are enforced by module_boundaries; temporary migration exceptions live only there.
foreach(module IN LISTS certpolysolve_module_names)
    string(JSON count LENGTH "${certpolysolve_module_manifest}" modules ${module} depends)
    if(count EQUAL 0)
        continue()
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON dependency GET "${certpolysolve_module_manifest}" modules ${module} depends ${index})
        if(TARGET certpolysolve_${dependency}_objects)
            target_link_libraries(certpolysolve_${module}_objects PRIVATE certpolysolve_${dependency}_objects)
        endif()
    endforeach()
endforeach()

add_library(certpolysolve_core INTERFACE)
target_link_libraries(certpolysolve_core INTERFACE ${certpolysolve_module_targets})
foreach(target IN LISTS certpolysolve_module_targets)
    # INTERFACE_SOURCES works with the supported CMake 3.20; placing TARGET_OBJECTS
    # in target_link_libraries instead would require CMake 3.21.
    target_sources(certpolysolve_core INTERFACE $<TARGET_OBJECTS:${target}>)
endforeach()
